# Build-time configuration for the docs site. Copy to `.env.local` for local
# development. CI writes `.env` from GitHub Environment variables, see
# `.github/workflows/deploy-dev.yml`.
#
# Only NEXT_PUBLIC_* values reach the browser bundle. Nothing here is secret:
# these are public endpoints, and the docs are a public site.

# xorgate-core-service base URL. Playground target and example snippets.
# Temporary dev value (the raw execute-api endpoint); swap once the custom API
# domain and /v1 prefix land.
NEXT_PUBLIC_API_BASE_URL=https://h357muxy3k.execute-api.us-east-1.amazonaws.com

# AWS region the platform runs in. Used in examples.
NEXT_PUBLIC_AWS_REGION=us-east-1

# Public origin this site is served from. Only used to build absolute OG image
# URLs. Production is https://docs.xorgate.io, development is
# https://docs-dev.xorgate.io. Use the CloudFront distribution domain instead
# while DNS is still being pointed.
NEXT_PUBLIC_SITE_URL=https://docs-dev.xorgate.io
